# ==============================================================================
# SPENDY / FINTRACK - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# Supabase Public Keys (Web & Edge)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Public Keys (Expo Mobile)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Server-only Secret Key (Never expose to client or Expo)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# App Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google Gemini Vision API for Smart Receipt OCR Scanner
GEMINI_API_KEY=your-gemini-api-key

